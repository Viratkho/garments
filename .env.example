# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Connection String (Prisma format)
DATABASE_URL="mysql://root:@localhost:3306/garmentflow_db"

# Authentication & Security
JWT_SECRET="your_secure_random_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Client CORS & Uploads
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
